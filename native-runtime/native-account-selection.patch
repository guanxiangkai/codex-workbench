+
+const ACCOUNT_DB_ENV: &str = "CODEX_WORKBENCH_ACCOUNT_DB";
+
+#[derive(Debug, PartialEq, Eq)]
+struct Selection {
+    account_id: String,
+    codex_home: PathBuf,
+    subject_id: String,
+}
+
+pub(crate) fn configured_db(base: &SharedModelProvider) -> Option<PathBuf> {
+    let info = base.info();
+    let is_supported = info.is_openai()
+        && info.requires_openai_auth
+        && info.base_url.as_deref().is_none_or(|url| {
+            url.trim_end_matches('/') == CHATGPT_CODEX_BASE_URL
+        })
+        && info.env_key.is_none()
+        && info.experimental_bearer_token.is_none()
+        && info.auth.is_none()
+        && info.aws.is_none()
+        && base.runtime_auth().is_none();
+    if !is_supported {
+        return None;
+    }
+    std::env::var_os(ACCOUNT_DB_ENV).map(PathBuf::from)
+}
+
+pub(crate) async fn selected_provider_from_db(
+    base: &SharedModelProvider,
+    db: &Path,
+) -> Result<SharedModelProvider, std::io::Error> {
+    let Some(manager) = base.auth_manager() else {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "workbench account selection requires an auth manager",
+        ));
+    };
+    if !manager.is_login_method_allowed(ForcedLoginMethod::Chatgpt)
+        || manager.is_workload_identity_selected()
+        || manager.has_external_auth()
+    {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::PermissionDenied,
+            "workbench account selection requires managed ChatGPT login",
+        ));
+    }
+    validate_local_file(db, "account database", false)?;
+    let current_home = canonical_local_path(&manager.runtime_config().codex_home, "current home")?;
+    let Selection {
+        account_id,
+        codex_home: home,
+        subject_id: subject,
+    } = read_selection(db, &current_home).await?;
+    let selected_home = if account_id == "current" {
+        let selected = home;
+        if selected != current_home {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                "current account home does not match runtime home",
+            ));
+        }
+        validate_auth_file(&selected)?;
+        selected
+    } else {
+        let selected = validate_isolated_home(&home)?;
+        if selected == current_home
+            || selected.starts_with(&current_home)
+            || current_home.starts_with(&selected)
+        {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                "isolated account home overlaps current home",
+            ));
+        }
+        selected
+    };
+    let child = manager
+        .account_manager_for_home(selected_home, &subject)
+        .await?;
+    if let Some(receipts) = std::env::var_os("CODEX_WORKBENCH_RUNTIME_RECEIPTS") {
+        // Readiness is separate from request authentication: a status-write failure
+        // must not make an authenticated model request switch identity or fail.
+        if let Err(error) = write_runtime_receipt(Path::new(&receipts), db, &account_id) {
+            tracing::warn!(%error, "could not publish workbench account runtime receipt");
+        }
+    }
+    Ok(create_model_provider(base.info().clone(), Some(child)))
+}
+
+fn write_runtime_receipt(directory: &Path, db: &Path, account_id: &str) -> std::io::Result<()> {
+    let metadata = std::fs::symlink_metadata(directory)?;
+    if !metadata.is_dir() || metadata.file_type().is_symlink() {
+        return Err(std::io::Error::other(
+            "runtime receipt directory must be an ordinary directory",
+        ));
+    }
+    let directory = canonical_local_path(directory, "runtime receipt directory")?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if metadata.uid() != unsafe { libc::geteuid() } || metadata.mode() & 0o777 != 0o700 {
+            return Err(std::io::Error::other(
+                "runtime receipt directory must be owner-only",
+            ));
+        }
+    }
+    let pid = std::process::id();
+    #[cfg(unix)]
+    let ppid = unsafe { libc::getppid() };
+    #[cfg(not(unix))]
+    let ppid = 0;
+    let observed_at_ms = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map_err(std::io::Error::other)?
+        .as_millis() as u64;
+    let receipt = serde_json::json!({
+        "schema": 1,
+        "mode": "request_account_snapshot",
+        "pid": pid,
+        "ppid": ppid,
+        "executable": std::fs::canonicalize(std::env::current_exe()?)?,
+        "database": std::fs::canonicalize(db)?,
+        "observed_at_ms": observed_at_ms,
+        "account_id": account_id,
+    });
+    let mut temporary = tempfile::NamedTempFile::new_in(&directory)?;
+    serde_json::to_writer(temporary.as_file_mut(), &receipt).map_err(std::io::Error::other)?;
+    temporary.as_file().sync_all()?;
+    temporary
+        .persist(directory.join(format!("{pid}.json")))
+        .map_err(|error| error.error)?;
+    Ok(())
+}
+
+async fn read_selection(db: &Path, current_home: &Path) -> Result<Selection, std::io::Error> {
+    let options = SqliteConnectOptions::new()
+        .filename(db)
+        .read_only(true)
+        .create_if_missing(false)
+        .busy_timeout(std::time::Duration::from_secs(2));
+    let pool = SqlitePoolOptions::new()
+        .max_connections(1)
+        .connect_with(options)
+        .await
+        .map_err(|e| std::io::Error::other(format!("cannot open account database: {e}")))?;
+    sqlx::query("PRAGMA trusted_schema=OFF")
+        .execute(&pool)
+        .await
+        .map_err(|e| std::io::Error::other(format!("cannot set SQLite policy: {e}")))?;
+    let row = sqlx::query(
+        "WITH pref AS (SELECT default_execution_account_id FROM preferences WHERE singleton=1)
+         SELECT p.default_execution_account_id, e.codex_home, e.subject_id
+         FROM pref p LEFT JOIN execution_accounts e ON e.id=p.default_execution_account_id
+         UNION ALL
+         SELECT 'current', e.codex_home, e.subject_id FROM execution_accounts e
+         WHERE e.id='current' AND e.codex_home=? AND NOT EXISTS(SELECT 1 FROM pref)",
+    )
+    .bind(current_home.to_str().ok_or_else(|| {
+        std::io::Error::new(std::io::ErrorKind::InvalidData, "current home is not UTF-8")
+    })?)
+    .fetch_optional(&pool)
+    .await
+    .map_err(|e| std::io::Error::other(format!("incompatible account database schema: {e}")))?;
+    pool.close().await;
+    let row = row.ok_or_else(|| {
+        std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            "current account binding is missing",
+        )
+    })?;
+    let account_id: Option<String> = row.try_get(0).map_err(sql_error)?;
+    let home: Option<String> = row.try_get(1).map_err(sql_error)?;
+    let subject_id: Option<String> = row.try_get(2).map_err(sql_error)?;
+    Ok(Selection {
+        account_id: account_id.filter(|v| !v.is_empty()).ok_or_else(|| {
+            std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                "default account is invalid",
+            )
+        })?,
+        codex_home: PathBuf::from(home.filter(|v| !v.is_empty()).ok_or_else(|| {
+            std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                "default account home is invalid",
+            )
+        })?),
+        subject_id: subject_id.filter(|v| !v.is_empty()).ok_or_else(|| {
+            std::io::Error::new(
+                std::io::ErrorKind::InvalidData,
+                "default account subject is invalid",
+            )
+        })?,
+    })
+}
+
+fn sql_error(error: sqlx::Error) -> std::io::Error {
+    std::io::Error::other(format!("invalid account database row: {error}"))
+}
+
+fn canonical_local_path(path: &Path, label: &str) -> Result<PathBuf, std::io::Error> {
+    if !path.is_absolute() {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            format!("{label} must be absolute"),
+        ));
+    }
+    let canonical = std::fs::canonicalize(path)?;
+    if canonical.components().any(|component| {
+        matches!(component, std::path::Component::Normal(value) if value == "CloudStorage" || value == "Mobile Documents" || value == "iCloud")
+    }) {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::PermissionDenied,
+            format!("{label} must be on local storage"),
+        ));
+    }
+    Ok(canonical)
+}
+
+fn validate_local_file(path: &Path, label: &str, single_link: bool) -> Result<(), std::io::Error> {
+    canonical_local_path(path, label)?;
+    let metadata = std::fs::symlink_metadata(path)?;
+    if !metadata.file_type().is_file() {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            format!("{label} must be an ordinary non-symlink file"),
+        ));
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if single_link && metadata.nlink() != 1 {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::PermissionDenied,
+                format!("{label} must have exactly one hard link"),
+            ));
+        }
+        if metadata.uid() != unsafe { libc::geteuid() } {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::PermissionDenied,
+                format!("{label} has a different owner"),
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn validate_isolated_home(path: &Path) -> Result<PathBuf, std::io::Error> {
+    let input_metadata = std::fs::symlink_metadata(path)?;
+    if !input_metadata.file_type().is_dir() || input_metadata.file_type().is_symlink() {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "isolated account home must be an ordinary non-symlink directory",
+        ));
+    }
+    let canonical = canonical_local_path(path, "isolated account home")?;
+    let metadata = std::fs::symlink_metadata(&canonical)?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::MetadataExt;
+        if metadata.mode() & 0o777 != 0o700 || metadata.uid() != unsafe { libc::geteuid() } {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::PermissionDenied,
+                "isolated account home must be owner-only mode 0700",
+            ));
+        }
+    }
+    validate_auth_file(&canonical)?;
+    Ok(canonical)
+}
+
+fn validate_auth_file(home: &Path) -> Result<(), std::io::Error> {
+    validate_local_file(&home.join("auth.json"), "account auth file", true)
+}
