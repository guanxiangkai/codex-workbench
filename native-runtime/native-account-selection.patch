+    /// Resolve the workbench account once at the request boundary.
+    ///
+    /// The returned client owns a fresh provider snapshot; callers must retain it for the
+    /// complete turn so a default-account change cannot affect an in-flight request.
+    pub(crate) async fn request_snapshot(&self) -> Result<Self> {
+        if self.runtime_auth.is_some() {
+            return Ok(self.clone());
+        }
+        let Some(db) = crate::workbench_accounts::configured_db(&self.state.provider) else {
+            return Ok(self.clone());
+        };
+        self.request_snapshot_from_db(&db).await
+    }
+
+    async fn request_snapshot_from_db(&self, db: &std::path::Path) -> Result<Self> {
+        if self.workbench_account_pinned {
+            return Ok(self.clone());
+        }
+        let provider =
+            crate::workbench_accounts::selected_provider_from_db(&self.state.provider, db).await?;
+        let http_client_factory = provider.auth_manager().map_or_else(
+            || self.http_client_factory.clone(),
+            |manager| manager.http_client_factory(),
+        );
+        Ok(Self {
+            state: Arc::new(ModelClientState {
+                thread_id: self.state.thread_id.clone(),
+                provider,
+                workspace_routing: self.state.workspace_routing.clone(),
