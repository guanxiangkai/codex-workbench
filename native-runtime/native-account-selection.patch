+
+    /// Return an isolated manager for an already selected account home.
+    ///
+    /// The child has its own auth cache and external provider. Managers for the
+    /// same home share refresh coordination, while the parent runtime
+    /// replacement APIs cannot mutate the child's cached identity.
+    pub async fn account_manager_for_home(
+        self: &Arc<Self>,
+        codex_home: PathBuf,
+        expected_account_id: &str,
+    ) -> std::io::Result<Arc<AuthManager>> {
+        if !self.is_login_method_allowed(ForcedLoginMethod::Chatgpt) {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::PermissionDenied,
+                "ChatGPT login is not allowed by the active authentication policy",
+            ));
+        }
+        if expected_account_id.is_empty() {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "expected account id must not be empty",
+            ));
+        }
+        // Keep the parent managed policy, but bind this child to the account it
+        // was created for.  The child may reload its auth file later; without
+        // this exact workspace restriction a replacement file could silently
+        // make the child adopt another account.
+        let parent_workspaces = self.effective_chatgpt_workspaces();
+        if parent_workspaces
+            .as_deref()
+            .is_some_and(|workspaces| !workspaces.iter().any(|id| id == expected_account_id))
+        {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::PermissionDenied,
+                "account identity is outside the parent workspace policy",
+            ));
+        }
+        let forced_chatgpt_workspace_id = Some(vec![expected_account_id.to_string()]);
+        let account_store = if codex_home == self.codex_home {
+            self.auth_credentials_store_mode.clone()
+        } else {
+            AuthCredentialsStoreMode::File
+        };
+        let config = AuthConfig {
+            codex_home: codex_home.clone(),
+            auth_credentials_store_mode: account_store,
+            keyring_backend_kind: self.keyring_backend_kind.clone(),
+            forced_login_method: Some(ForcedLoginMethod::Chatgpt),
+            chatgpt_base_url: self.chatgpt_base_url.clone(),
+            forced_chatgpt_workspace_id,
+            managed_auth_policy: self.managed_auth_policy.clone(),
+            auth_route_config: self.auth_route_config.clone(),
+        };
+        config.validate()?;
+        let key = (codex_home.clone(), expected_account_id.to_string());
+        let mut cache = self.workbench_account_managers.lock().await;
+        if let Some(manager) = cache.get(&key) {
+            let auth = manager.auth_cached().ok_or_else(|| {
+                std::io::Error::new(
+                    std::io::ErrorKind::PermissionDenied,
+                    "account auth unavailable",
+                )
+            })?;
+            if !config.allows_auth(&auth)
+                || !auth.is_chatgpt_auth()
+                || auth.get_account_id().as_deref() != Some(expected_account_id)
+            {
+                cache.remove(&key);
+                return Err(std::io::Error::new(
+                    std::io::ErrorKind::PermissionDenied,
+                    "account identity mismatch",
+                ));
+            }
+            return Ok(Arc::clone(manager));
+        }
+        let mut manager = Self::new_from_auth_config(
+            config.clone(),
+            /*enable_codex_api_key_env*/ false,
+            Some(vec![AuthMode::Chatgpt]),
+        )
+        .await;
+        // Managers may point at the same auth home (including two identity
+        // keys during a file replacement). Keep their refresh critical
+        // section shared, while retaining separate auth caches and identity
+        // policies.
+        if codex_home == self.codex_home {
+            manager.refresh_lock = Arc::clone(&self.refresh_lock);
+        } else if let Some(existing) = cache
+            .values()
+            .find(|existing| existing.codex_home == codex_home)
+        {
+            manager.refresh_lock = Arc::clone(&existing.refresh_lock);
+        }
+        let manager = Arc::new(manager);
+        let auth = manager.auth_cached().ok_or_else(|| {
+            std::io::Error::new(
+                std::io::ErrorKind::PermissionDenied,
+                "account auth unavailable",
+            )
+        })?;
+        if !config.allows_auth(&auth)
+            || !auth.is_chatgpt_auth()
+            || auth.get_account_id().as_deref() != Some(expected_account_id)
+        {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::PermissionDenied,
+                "account identity mismatch",
+            ));
+        }
+        cache.insert(key, Arc::clone(&manager));
         Ok(manager)
     }
 
