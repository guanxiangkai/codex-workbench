+#[cfg(unix)]
+#[tokio::test]
+async fn workbench_default_switch_uses_new_token_on_the_same_thread() {
+    use sqlx::SqlitePool;
+    use sqlx::sqlite::SqliteConnectOptions;
+    use std::os::unix::fs::DirBuilderExt;
+
+    async fn request_identity(client: &ModelClient) -> (String, String) {
+        let setup = client
+            .current_client_setup(super::ClientRouting::Workspace)
+            .await
+            .unwrap();
+        let mut headers = http::HeaderMap::new();
+        setup.api_auth.add_auth_headers(&mut headers).unwrap();
+        (
+            headers[http::header::AUTHORIZATION].to_str().unwrap().to_string(),
+            headers["chatgpt-account-id"].to_str().unwrap().to_string(),
+        )
+    }
+
+    let temp = TempDir::new().unwrap();
+    let root = temp.path().canonicalize().unwrap();
+    let desktop_home = root.join("desktop");
+    std::fs::create_dir(&desktop_home).unwrap();
+    let manager = AuthManager::from_auth_for_testing_with_home(
+        CodexAuth::create_dummy_chatgpt_auth_for_testing(),
+        desktop_home,
+    );
+    let mut client = test_model_client(SessionSource::Cli);
+    Arc::get_mut(&mut client.state).unwrap().provider = create_model_provider(
+        ModelProviderInfo::create_openai_provider(None),
+        Some(manager),
+    );
+
+    let db = root.join("workbench.sqlite3");
+    let pool = SqlitePool::connect_with(
+        SqliteConnectOptions::new().filename(&db).create_if_missing(true),
+    )
+    .await
+    .unwrap();
+    for statement in [
+        "CREATE TABLE preferences(singleton INTEGER PRIMARY KEY, default_execution_account_id TEXT)",
+        "CREATE TABLE execution_accounts(id TEXT PRIMARY KEY, codex_home TEXT, subject_id TEXT)",
+        "INSERT INTO preferences VALUES (1, 'a')",
+    ] {
+        sqlx::query(statement).execute(&pool).await.unwrap();
+    }
+    for (id, subject, token) in [
+        ("a", "workbench-account-a", "workbench-token-a"),
+        ("b", "workbench-account-b", "workbench-token-b"),
+    ] {
+        let home = root.join(id);
+        std::fs::DirBuilder::new().mode(0o700).create(&home).unwrap();
+        // The fixture has no live credentials. Only the authorization headers are inspected.
+        let auth = json!({
+            "auth_mode": AuthMode::Chatgpt,
+            "tokens": {
+                "id_token": "e30.e30.fixture",
+                "access_token": token,
+                "refresh_token": "unused-fixture",
+                "account_id": subject,
+            },
+            "last_refresh": chrono::Utc::now(),
+        });
+        std::fs::write(home.join("auth.json"), auth.to_string()).unwrap();
+        sqlx::query("INSERT INTO execution_accounts VALUES (?, ?, ?)")
+            .bind(id)
+            .bind(home.to_str().unwrap())
+            .bind(subject)
+            .execute(&pool)
+            .await
+            .unwrap();
+    }
+
+    let first_turn = client.request_snapshot_from_db(&db).await.unwrap();
+    let a = ("Bearer workbench-token-a".into(), "workbench-account-a".into());
+    let b = ("Bearer workbench-token-b".into(), "workbench-account-b".into());
+    assert_eq!(request_identity(&first_turn).await, a);
+
+    sqlx::query("UPDATE preferences SET default_execution_account_id='b' WHERE singleton=1")
+        .execute(&pool)
+        .await
+        .unwrap();
+    let still_first_turn = first_turn.request_snapshot_from_db(&db).await.unwrap();
+    let next_turn = client.request_snapshot_from_db(&db).await.unwrap();
+    assert_eq!(still_first_turn.state.thread_id, client.state.thread_id);
+    assert_eq!(next_turn.state.thread_id, client.state.thread_id);
+    assert_eq!(request_identity(&still_first_turn).await, a);
+    assert_eq!(request_identity(&next_turn).await, b);
+}
